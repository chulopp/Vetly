# ── Vetly environment ────────────────────────────────────────────────
# Copy this file to .env.local for local dev, and set the same vars in
# your Vercel project settings for production. Never commit .env.local.

# Neon Postgres connection string (required for saving offers).
# Example: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# DeepSeek API key — powers Smart Paste extraction and negotiation drafting.
# Without it, both features degrade gracefully: Smart Paste falls back to
# manual entry and the draft button stays inert. The core analysis is unaffected.
DEEPSEEK_API_KEY=

# Optional overrides
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=
